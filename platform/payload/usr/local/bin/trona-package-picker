#!/usr/bin/python3
"""Touch interface to Omarchy's repository package installer."""
import subprocess
import threading

import gi
gi.require_version('Gtk', '3.0')
from gi.repository import GLib, Gtk, Pango


def install_command(names):
    return ['xdg-terminal-exec', '--app-id=org.omarchy.terminal', '/bin/bash', '-c',
            'source omarchy-sudo-keepalive || exit 1\n'
            'sudo pacman -S --noconfirm -- "$@"\n'
            'omarchy-show-done "$?"', 'omarchy-pkg-install', *names]


class Picker(Gtk.Window):
    def __init__(self):
        super().__init__(title='Pakete installieren')
        self.set_default_size(600, 620)
        self.connect('destroy', Gtk.main_quit)
        self.selected = set()
        self.names = []
        self.filter_text = ''
        self.details_request = 0
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin=12)
        self.add(box)
        self.search = Gtk.SearchEntry(placeholder_text='Pakete suchen')
        self.search.set_size_request(-1, 46)
        self.search.connect('search-changed', self.search_changed)
        box.pack_start(self.search, False, False, 0)
        # Store only visible results. Keep selection by name across searches.
        self.model = Gtk.ListStore(bool, str)
        self.view = Gtk.TreeView(model=self.model, headers_visible=False, enable_search=False)
        check = Gtk.CellRendererToggle()
        check.connect('toggled', lambda _, path: self.toggle(self.model[path][1], path))
        self.view.append_column(Gtk.TreeViewColumn('Auswahl', check, active=0))
        label = Gtk.CellRendererText(ellipsize=Pango.EllipsizeMode.END, ypad=10)
        col = Gtk.TreeViewColumn('Paket', label, text=1)
        col.set_expand(True)
        self.view.append_column(col)
        self.view.set_activate_on_single_click(True)
        self.view.connect('row-activated', self.row_activated)
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.add(self.view)
        box.pack_start(scroll, True, True, 0)
        self.details = Gtk.Expander(label='Paketdetails')
        self.details.connect('notify::expanded', lambda *_: self.update_details())
        self.description = Gtk.TextView(editable=False, cursor_visible=False,
                                        wrap_mode=Gtk.WrapMode.WORD_CHAR)
        details_scroll = Gtk.ScrolledWindow()
        details_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        details_scroll.set_size_request(-1, 112)
        details_scroll.add(self.description)
        self.details.add(details_scroll)
        box.pack_start(self.details, False, False, 0)
        self.view.get_selection().connect('changed', lambda *_: self.update_details())
        self.status = Gtk.Label(label='Paketliste wird geladen …', xalign=0,
                                ellipsize=Pango.EllipsizeMode.END)
        box.pack_start(self.status, False, False, 0)
        actions = Gtk.Box(spacing=8, homogeneous=True)
        cancel = Gtk.Button(label='Abbrechen')
        cancel.connect('clicked', lambda *_: self.destroy())
        self.install = Gtk.Button(label='Installieren', sensitive=False)
        self.install.get_style_context().add_class('suggested-action')
        self.install.connect('clicked', self.start_install)
        for button in (cancel, self.install):
            button.set_size_request(-1, 48)
            actions.pack_start(button, True, True, 0)
        box.pack_start(actions, False, False, 0)
        self.connect('key-press-event', self.key_press)
        self.show_all()
        self.search.grab_focus()
        threading.Thread(target=self.load, daemon=True).start()

    def key_press(self, _, event):
        from gi.repository import Gdk
        if event.keyval == Gdk.KEY_Escape:
            if self.search.get_text():
                self.search.set_text('')
            else:
                self.destroy()
            return True
        return False

    def load(self):
        try:
            result = subprocess.run(['pacman', '-Slq'], capture_output=True, text=True, check=True)
            names = sorted(set(result.stdout.splitlines()))
            GLib.idle_add(self.loaded, names)
        except (OSError, subprocess.CalledProcessError):
            GLib.idle_add(self.status.set_text, 'Paketliste konnte nicht geladen werden.')

    def loaded(self, names):
        self.names = names
        self.search_changed()
        return False

    def search_changed(self, *_):
        self.filter_text = self.search.get_text().strip().casefold()
        previous = getattr(self, 'fill_source', 0)
        if previous:
            GLib.source_remove(previous)
        self.model.clear()
        terms = self.filter_text.split()
        matches = [name for name in self.names if all(term in name.casefold() for term in terms)]
        self.count = len(matches)
        rows = iter(matches)
        self.refresh_status()

        def fill():
            for _ in range(128):
                name = next(rows, None)
                if name is None:
                    self.fill_source = 0
                    return False
                self.model.append((name in self.selected, name))
            return True

        self.fill_source = GLib.idle_add(fill)

    def row_activated(self, view, path, column):
        if column != view.get_column(0):
            self.toggle(self.model[path][1], path)

    def toggle(self, name, path):
        if name in self.selected:
            self.selected.remove(name)
        else:
            self.selected.add(name)
        self.model[path][0] = name in self.selected
        self.refresh_status()

    def refresh_status(self):
        self.status.set_text(f'{self.count} Treffer · {len(self.selected)} ausgewählt')
        self.install.set_sensitive(bool(self.selected))

    def update_details(self):
        self.details_request += 1
        request = self.details_request
        if not self.details.get_expanded():
            return
        model, it = self.view.get_selection().get_selected()
        buf = self.description.get_buffer()
        if it is None:
            buf.set_text('Ein Paket in der Liste antippen.')
            return
        name = model[it][1]
        buf.set_text(name)

        def fetch():
            try:
                p = subprocess.run(['pacman', '-Si', '--', name], capture_output=True, text=True, timeout=5)
                data = p.stdout if p.returncode == 0 else 'Keine Paketdetails verfügbar.'
            except (OSError, subprocess.TimeoutExpired):
                data = 'Keine Paketdetails verfügbar.'
            def display():
                if self.details_request == request:
                    buf.set_text(data)
                return False
            GLib.idle_add(display)
        threading.Thread(target=fetch, daemon=True).start()

    def start_install(self, _):
        if not self.selected:
            return
        try:
            subprocess.Popen(install_command(sorted(self.selected)), start_new_session=True)
        except OSError as error:
            self.status.set_text(str(error))
            return
        self.destroy()


if __name__ == '__main__':
    GLib.set_prgname('trona-package-picker')
    GLib.set_application_name('Pakete installieren')
    Picker()
    Gtk.main()
