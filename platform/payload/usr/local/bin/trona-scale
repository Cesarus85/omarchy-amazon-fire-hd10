#!/usr/bin/python3
"""Cycle readable display sizes, persisted and shared with manual rotation."""
import fcntl,json,os,pathlib,subprocess,sys,time
run=lambda *a:subprocess.check_output(a,text=True,timeout=15)
def hypr(*a):return run('/usr/bin/hyprctl','-i','0',*a)
if os.getuid()==0:raise SystemExit('Run as desktop user')
r=pathlib.Path(os.environ['XDG_RUNTIME_DIR'])
with (r/'trona-rotation.lock').open('w') as lock:
 try:fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
 except BlockingIOError:raise SystemExit(0)
 m=next(m for m in json.loads(hypr('-j','monitors')) if m['name']=='DSI-1')
 allowed=[1.25,1.0,1.5]; action=sys.argv[1] if len(sys.argv)>1 else 'toggle'
 target=allowed[(allowed.index(m['scale'])+1)%3] if action=='toggle' and m['scale'] in allowed else (1.25 if action=='toggle' else float(action))
 if target not in allowed:raise SystemExit('Supported sizes: 1.0, 1.25, 1.5')
 hypr('eval',f'hl.monitor({{output="DSI-1",mode="preferred",position="auto",scale={target},transform={m["transform"]}}})')
 now=next(m for m in json.loads(hypr('-j','monitors')) if m['name']=='DSI-1')
 if now['scale']!=target:raise SystemExit('Scale did not apply')
 p=pathlib.Path.home()/'.local/state/trona/scale';p.parent.mkdir(parents=True,exist_ok=True)
 tmp=p.with_suffix('.tmp');tmp.write_text(str(target)+'\n');tmp.replace(p)
 run('/usr/local/libexec/trona-fit-windows','--once')
 if action=='toggle':subprocess.run(['/usr/bin/notify-send','Anzeigegröße',f'{round(target*100)} % — A± wechselt zwischen 100, 125 und 150 %.'],check=False)
 print(json.dumps({'scale':target,'transform':now['transform']}))
