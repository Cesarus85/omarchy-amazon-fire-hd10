+		if (READ_ONCE(trona_opaque_blit) && dst.is_iomem &&
+		    !shadow_plane_state->data[0].is_iomem &&
+		    fb->format->format == DRM_FORMAT_XRGB8888 &&
+		    dst_format->format == DRM_FORMAT_ARGB8888 &&
+		    !((unsigned long)dst.vaddr_iomem & 3) && !(dst_pitch & 3) &&
+		    of_machine_is_compatible("amazon,trona")) {
+			const u8 *src = shadow_plane_state->data[0].vaddr;
