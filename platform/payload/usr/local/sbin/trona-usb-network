#!/bin/bash
set -euo pipefail
g=/sys/kernel/config/usb_gadget/trona_probe
if [[ ! -L $g/configs/c.1/ecm.usb0 ]]; then
 udc=$(cat "$g/UDC")
 echo '' > "$g/UDC"
 mkdir -p "$g/functions/ecm.usb0"
 echo 02:54:52:4f:4e:01 > "$g/functions/ecm.usb0/host_addr"
 echo 02:54:52:4f:4e:02 > "$g/functions/ecm.usb0/dev_addr"
 ln -s "$g/functions/ecm.usb0" "$g/configs/c.1/ecm.usb0"
 echo 'Serial and USB network' > "$g/configs/c.1/strings/0x409/configuration"
 echo "$udc" > "$g/UDC"
fi
ip link set usb0 up
ip addr replace 169.254.77.2/16 dev usb0
# Stable cable-only maintenance address, ready before sshd starts.
ip -6 addr replace fe80::54:52ff:fe4f:4e02/64 dev usb0 nodad
