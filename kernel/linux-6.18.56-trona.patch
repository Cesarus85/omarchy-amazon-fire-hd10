+++ b/drivers/usb/typec/tcpm/trona_charge_policy.h
@@ -0,0 +1,152 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Trona-only conservative 5 V sink policy. The generic MT6370 charger stays
+ * disabled: this policy is the sole owner of CHG_EN/IAICR/IINLMTSEL/ICHG.
+ * Preserve CV, MIVR, termination threshold and protection registers.
+ * Select programmable IAICR above 500 mA only with a Type-C allowance.
+ * Restore the conservative external ILIM pin limit on default/disconnect.
+ */
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/power_supply.h>
+#include <linux/workqueue.h>
+#include <linux/suspend.h>
+
+struct trona_charge_policy {
+ struct device *dev;
+ struct regmap *map;
+ struct mutex lock;
+ struct delayed_work work;
+ unsigned int requested_ma, requested_mv;
+ int applied_ma, enabled;
+ bool stopping, active, suspended, pm_registered;
+ struct notifier_block pm_notifier;
+};
+
+static int trona_charge_apply(struct trona_charge_policy *p)
+{
+ struct power_supply *battery;
+ union power_supply_propval t, v;
+ unsigned int ps, ovp, ctrl, cv;
+ int ret, ma, enable = 0;
+
+ if (p->suspended) return 0;
+ ret = regmap_read(p->map, 0x1e, &ps);
+ if (!ret) ret = regmap_read(p->map, 0x1d8, &ovp);
+ if (!ret) ret = regmap_read(p->map, 0x111, &ctrl);
+ if (!ret) ret = regmap_read(p->map, 0x114, &cv);
+ if (ret) goto fail_closed;
+ /* No boost, no unexpected CV, and a present 5 V sink source. */
+ ma = 100;
+ if ((ps & BIT(2)) && !(ovp & BIT(4)) && !(ctrl & BIT(0)) &&
+     (cv & 0xfe) == 0x3c && p->requested_mv == 5000)
+  ma = clamp_t(unsigned int, p->requested_ma, 100, 1500);
+ ma = 100 + (ma - 100) / 50 * 50;
+ battery = power_supply_get_by_name("BAT0");
+ if (battery) {
+  ret = power_supply_get_property(battery, POWER_SUPPLY_PROP_TEMP, &t);
+  if (!ret) ret = power_supply_get_property(battery, POWER_SUPPLY_PROP_VOLTAGE_NOW, &v);
+  if (!ret && t.intval >= 100 && t.intval <= 400 &&
+      v.intval >= 3000000 && v.intval <= 4250000 &&
+      p->requested_ma >= 100 && p->requested_mv == 5000 &&
+      (ps & BIT(2)) && !(ovp & BIT(4)) && !(ctrl & BIT(0)) &&
+      (cv & 0xfe) == 0x3c)
+   enable = 1;
+  power_supply_put(battery);
+ }
+ ret = regmap_update_bits(p->map, 0x113, 0xff,
+        (((ma - 100) / 50) << 2) | BIT(1) | (ma <= 500 ? BIT(0) : 0));
+ if (!ret) ret = regmap_update_bits(p->map, 0x112, BIT(0), enable);
+ if (ret) goto fail_closed;
+ if (ma != p->applied_ma || enable != p->enabled)
+  dev_info(p->dev, "Trona USB sink: source=%u mA/%u mV, input=%d mA, charge=%s (900 mA cap)\n",
+           p->requested_ma, p->requested_mv, ma, enable ? "on" : "off");
+ p->applied_ma = ma; p->enabled = enable;
+ return 0;
+fail_closed:
+ regmap_update_bits(p->map, 0x113, 0xff, BIT(1) | BIT(0));
+ regmap_update_bits(p->map, 0x112, BIT(0), 0);
+ p->applied_ma = 100; p->enabled = 0;
+ dev_err_ratelimited(p->dev, "charge policy I/O failure: %d; requested safe fallback\n", ret);
+ return ret;
+}
+
+static void trona_charge_work(struct work_struct *work)
+{
+ struct trona_charge_policy *p = container_of(to_delayed_work(work), struct trona_charge_policy, work);
+ mutex_lock(&p->lock);
+ if (!p->stopping) {
+  trona_charge_apply(p);
+  queue_delayed_work(system_freezable_wq, &p->work, HZ);
+ }
+ mutex_unlock(&p->lock);
+}
+static int trona_charge_set_limit(struct trona_charge_policy *p, unsigned int ma, unsigned int mv)
+{
+ int ret;
+ mutex_lock(&p->lock);
+ p->requested_ma = ma; p->requested_mv = mv;
+ ret = p->stopping ? -ESHUTDOWN : trona_charge_apply(p);
+ mutex_unlock(&p->lock);
+ return ret;
+}
+/* Software temperature checks cannot run while the system sleeps. Pause
+ * pack charging before devices suspend, retaining the authorized input path.
+ * On resume BAT0 refreshes and the ordinary guarded policy restarts charging.
+ */
+static int trona_charge_pm(struct notifier_block *nb, unsigned long event, void *unused)
+{
+ struct trona_charge_policy *p = container_of(nb, struct trona_charge_policy, pm_notifier);
+ int ret = 0;
+ switch (event) {
+ case PM_SUSPEND_PREPARE:
+  mutex_lock(&p->lock);
+  p->suspended = true;
+  ret = regmap_update_bits(p->map, 0x112, BIT(0), 0);
+  if (!ret) p->enabled = 0;
+  mutex_unlock(&p->lock);
+  cancel_delayed_work_sync(&p->work);
+  return notifier_from_errno(ret);
+ case PM_POST_SUSPEND:
+  mutex_lock(&p->lock);
+  p->suspended = false;
+  if (!p->stopping) mod_delayed_work(system_freezable_wq, &p->work, 0);
+  mutex_unlock(&p->lock);
+  break;
+ }
+ return NOTIFY_OK;
+}
+static void trona_charge_stop(void *data)
+{
+ struct trona_charge_policy *p = data;
+ if (p->pm_registered) unregister_pm_notifier(&p->pm_notifier);
+ mutex_lock(&p->lock); p->stopping = true; mutex_unlock(&p->lock);
+ cancel_delayed_work_sync(&p->work);
+ /* A removed controller cannot authorize a higher current. */
+ regmap_update_bits(p->map, 0x113, 0xff, BIT(1) | BIT(0));
+ regmap_update_bits(p->map, 0x112, BIT(0), 0);
+}
+static int trona_charge_init(struct trona_charge_policy *p, struct device *dev, struct regmap *map)
+{
+ unsigned int cv, ctrl; int ret;
+ if (!of_machine_is_compatible("amazon,trona")) return 0;
+ ret = regmap_read(map, 0x114, &cv);
+ if (!ret) ret = regmap_read(map, 0x111, &ctrl);
+ if (ret) return ret;
+ if ((cv & 0xfe) != 0x3c || (ctrl & BIT(0))) return -EINVAL;
+ p->dev = dev; p->map = map; p->applied_ma = -1; p->enabled = -1;
+ mutex_init(&p->lock); INIT_DELAYED_WORK(&p->work, trona_charge_work);
+ /* Reduce limits before selecting the programmable input-current source. */
+ ret = regmap_update_bits(map, 0x113, 0xff, BIT(1) | BIT(0)); /* AICR enabled, 100 mA until attach */
+ if (!ret) ret = regmap_update_bits(map, 0x117, 0xfc, 8 << 2); /* 900 mA */
+ if (!ret) ret = regmap_update_bits(map, 0x112, 0x1d, 0x18); /* IAICR, termination on, charging off */
+ if (ret) return ret;
+ p->active = true;
+ ret = devm_add_action_or_reset(dev, trona_charge_stop, p);
+ if (ret) return ret;
+ p->pm_notifier.notifier_call = trona_charge_pm;
+ ret = register_pm_notifier(&p->pm_notifier);
+ if (ret) return ret;
+ p->pm_registered = true;
+ queue_delayed_work(system_freezable_wq, &p->work, HZ);
+ return 0;
+}
