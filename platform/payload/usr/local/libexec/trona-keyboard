#!/usr/bin/python3
"""Size the keyboard from Hyprland's actual transform, not EDID dimensions."""
import json,os,pathlib,subprocess,time
state=pathlib.Path.home()/".local/state/trona/keyboard-visible"
if state.exists() and state.read_text().strip()=="0":raise SystemExit(0)
for _ in range(30):
 try:
  monitors=json.loads(subprocess.check_output(['/usr/bin/hyprctl','-i','0','-j','monitors'],text=True,timeout=3))
  monitor=next(m for m in monitors if m['name']=='DSI-1')
  height='200' if monitor['transform']%2 else '280'
  os.execv('/usr/local/bin/wvkbd-mobintl',['wvkbd-mobintl','-H',height,'-L',height])
 except (subprocess.SubprocessError,StopIteration,json.JSONDecodeError):time.sleep(.3)
raise SystemExit('Tablet display not ready')
