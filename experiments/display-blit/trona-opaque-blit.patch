+/* Trona's inherited OVL0 consumes ARGB with alpha blending enabled.
+ * Write opaque little-endian pixels to its WC framebuffer in one pass.
+ * The generic conversion remains available for comparison and fallback.
+ */
+static bool trona_opaque_blit;
+module_param(trona_opaque_blit, bool, 0600);
+
+static noinline void trona_copy_opaque(void __iomem *dst, unsigned int dst_pitch,
+				      const void *src, unsigned int src_pitch,
+				      unsigned int width, unsigned int height)
+{
+	const u64 alpha = 0xff000000ff000000ULL;
+
+	while (height--) {
+		void __iomem *out = dst;
+		const u8 *in = src;
+		unsigned int n = width;
+
+		if (n && ((unsigned long)out & 7)) {
+			writel_relaxed(get_unaligned_le32(in) | 0xff000000, out);
+			in += 4;
+			out += 4;
+			n--;
+		}
+		while (n >= 8) {
+			u64 a = get_unaligned_le64(in) | alpha;
+			u64 b = get_unaligned_le64(in + 8) | alpha;
+			u64 c = get_unaligned_le64(in + 16) | alpha;
+			u64 d = get_unaligned_le64(in + 24) | alpha;
+
+			writeq_relaxed(a, out);
+			writeq_relaxed(b, out + 8);
+			writeq_relaxed(c, out + 16);
+			writeq_relaxed(d, out + 24);
+			in += 32;
+			out += 32;
+			n -= 8;
+		}
+		while (n--) {
+			writel_relaxed(get_unaligned_le32(in) | 0xff000000, out);
+			out += 4;
+			in += 4;
+		}
+		src += src_pitch;
+		dst += dst_pitch;
+	}
+	wmb();
+}
+
