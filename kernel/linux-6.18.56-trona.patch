+// SPDX-License-Identifier: GPL-2.0
+/* Adapt LK's runtime framebuffer address for the trona simpledrm trial. */
+#include <linux/init.h>
+#include <linux/of.h>
+#include <linux/slab.h>
+#include <linux/unaligned.h>
+
+static int __init trona_bootfb_init(void)
+{
+ struct device_node *chosen, *fb;
+ const void *tag;
+ struct property *p;
+ __be32 *cells;
+ u64 base;
+ u32 vram;
+ int len, ret;
+ if (!of_machine_is_compatible("amazon,trona")) return 0;
+ chosen = of_find_node_by_path("/chosen");
+ if (!chosen) return -ENODEV;
+ tag = of_get_property(chosen, "atag,videolfb", &len);
+ if (!tag || len < 20) { of_node_put(chosen); return -EINVAL; }
+ base = get_unaligned_le64(tag);
+ vram = get_unaligned_le32(tag + 16);
+ of_node_put(chosen);
+ /* Refuse an unexpected tag; never map arbitrary device registers as RAM. */
+ if (base < 0x40000000ULL || base + vram > 0x100000000ULL ||
+     vram < 4864 * 1920 || vram > 0x8000000) return -EINVAL;
+ fb = of_find_node_by_path("/chosen/framebuffer@624e0000");
+ if (!fb) return -ENODEV;
+ p = kzalloc(sizeof(*p), GFP_KERNEL);
+ cells = kmalloc(4 * sizeof(*cells), GFP_KERNEL);
+ if (!p || !cells) { kfree(p); kfree(cells); of_node_put(fb); return -ENOMEM; }
+ p->name = kstrdup("reg", GFP_KERNEL); p->length = 16; p->value = cells;
+ if (!p->name) { kfree(cells); kfree(p); of_node_put(fb); return -ENOMEM; }
+ cells[0] = cpu_to_be32(base >> 32); cells[1] = cpu_to_be32(base);
+ cells[2] = 0; cells[3] = cpu_to_be32(4864 * 1920);
+ ret = of_update_property(fb, p);
+ pr_info("TRONA_MAINLINE: LK framebuffer base=%llx vram=%x update=%d\n", base, vram, ret);
+ of_node_put(fb);
+ return ret;
+}
+arch_initcall(trona_bootfb_init);
