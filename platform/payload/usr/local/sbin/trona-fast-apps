#!/usr/bin/python3
"""Keep the measured Trona app/dock fast paths across qualified Omarchy updates."""
from pathlib import Path
import argparse

MARKER = '// Trona app responsiveness v1'

def patch_library(s):
    changes = [
        ('  property var pendingIconIndex: ({})',
         '  property var pendingIconIndex: ({})\n  property double tronaIconIndexUpdatedAt: 0'),
        ('    if (!iconIndexScan.running) iconIndexScan.running = true',
         '    // Entry changes still force a scan; repeated opens reuse the index.\n'
         '    if (!iconIndexScan.running && (root.tronaIconIndexUpdatedAt === 0 ||\n'
         '        Date.now() - root.tronaIconIndexUpdatedAt >= 60000)) iconIndexScan.running = true'),
        ('      Util.execDetached("omarchy-launch-tui " + command.map(function(word) { return Util.shellQuote(word) }).join(" "))',
         '      Quickshell.execDetached(["omarchy-launch-tui"].concat(command))'),
        ('    Util.execDetached("uwsm-app -- gtk-launch " + Util.shellQuote(id + ".desktop"))',
         '    // Inherit the established GUI environment; keep the UWSM app scope.\n'
         '    Quickshell.execDetached(["uwsm-app", "--", "gtk-launch", id + ".desktop"])'),
        ('    onExited: root.iconIndex = root.pendingIconIndex',
         '''    onExited: function(exitCode) {
      if (exitCode !== 0) return
      root.tronaIconIndexUpdatedAt = Date.now()
      var next = root.pendingIconIndex
      var keys = Object.keys(next)
      var changed = keys.length !== Object.keys(root.iconIndex).length
      for (var i = 0; !changed && i < keys.length; i++) {
        if (root.iconIndex[keys[i]] !== next[keys[i]]) changed = true
      }
      // An unchanged scan must not invalidate every visible icon binding.
      if (changed) root.iconIndex = next
    }'''),
    ]
    s = transform(s, changes)
    return transform(s, [
        ('Quickshell.execDetached(["uwsm-app", "--", "gtk-launch", id + ".desktop"])',
         'Quickshell.execDetached(["uwsm-app", "--", "/usr/local/libexec/trona-launch-desktop", id + ".desktop"])'),
    ], '// Trona desktop entry launch v2')

def patch_dock(s):
    anchor='    var target = "window = \\\"address:" + address + "\\\""'
    replacement=anchor+'''
    // The ordinary focus path needs no login shell or hyprctl processes.
    // Keep the existing minimized-window restore/animation sequence below.
    if (!window.minimized) {
      Hyprland.dispatch("hl.dsp.focus({ " + target + " })")
      Hyprland.dispatch("hl.dsp.window.alter_zorder({ mode = \\"top\\", " + target + " })")
      return
    }'''
    s = transform(s, [(anchor,replacement)])
    # Changing the stack of a maximized tiled client can refocus a floating
    # neighbor. Leave explicit focus as the last compositor operation.
    focus = '      Hyprland.dispatch("hl.dsp.focus({ " + target + " })")'
    raise_window = r'      Hyprland.dispatch("hl.dsp.window.alter_zorder({ mode = \"top\", " + target + " })")'
    ordered = raise_window + '\n' + focus
    s = transform(s, [(focus + '\n' + raise_window, ordered)], '// Trona dock focus order v2')
    dispatch = '      Hyprland.dispatch("trona_dock_focus(" + JSON.stringify("address:" + address) + ")")'
    return transform(s, [(ordered, dispatch)], '// Trona dock visible focus v3')


def patch_dock_window(s):
    button = """      TronaNavButton {
        visible: window.tabletDock
        width: window.slotSize
        height: window.slotSize
        onBack: {
          if (window.menuOpen) window.closeMenu()
          else Quickshell.execDetached(["/usr/bin/wtype", "-k", "Escape"])
        }
      }"""
    close = """      TronaNavButton {
        visible: window.tabletDock
        width: window.slotSize
        height: window.slotSize
        closeWindow: true
        allowClose: !window.menuOpen
      }"""
    s = transform(s, [
        ('  readonly property bool shown:', '  readonly property bool tabletDock: screen?.name === "DSI-1" && position === "bottom"\n  readonly property bool shown:'),
        ('dock.isFloating(workspaceId) && fullscreenMode', '(tabletDock || dock.isFloating(workspaceId)) && fullscreenMode'),
        ('dock.autohide || fullscreenMode === 1', 'dock.autohide || (!tabletDock && fullscreenMode === 1)'),
        ('  exclusiveZone: 0', '  exclusiveZone: tabletDock && shown && !autohide ? slotSize + gap : 0'),
        ('? screen.height - bottom - window.height', '? screen.height - (window.exclusiveZone > 0 ? 0 : bottom) - window.height'),
        ('appRepeater.count + 1', 'window.tabletDock ? 4 : 2'),
        ('    var first = window.slotSize', '    var first = window.slotSize - appViewport.contentX'),
        ("""      Repeater {
        id: appRepeater
        model: window.dock ? window.dock.itemModel : null

        delegate: AppSlot {}
      }""", """      Flickable {
        id: appViewport
        // Keep the grid and navigation reachable if many apps are open.
        // Only the app icons scroll; with room to spare dragging reorders them.
        width: window.tabletDock ? Math.min(contentWidth, Math.max(window.slotSize, window.width - 3 * window.slotSize - 2 * window.gap)) : contentWidth
        height: contentHeight
        contentWidth: appIcons.implicitWidth
        contentHeight: appIcons.implicitHeight
        interactive: window.tabletDock && contentWidth > width
        clip: interactive
        boundsBehavior: Flickable.StopAtBounds
        flickableDirection: Flickable.HorizontalFlick
        Grid {
          id: appIcons
          columns: window.vertical ? 1 : Math.max(1, appRepeater.count)
          Repeater {
            id: appRepeater
            model: window.dock ? window.dock.itemModel : null
            delegate: AppSlot {}
          }
        }
      }""" + '\n' + button + '\n' + close),
        ('      if (!(appSlot.mouse.pressedButtons & Qt.LeftButton)) return',
         '      if (appViewport.interactive || !(appSlot.mouse.pressedButtons & Qt.LeftButton)) return'),
    ], '// Trona dock touch navigation v1')
    s = transform(s, [
        ('  readonly property bool shown: !!dock', """  TronaKeyboardEdge {
    id: keyboardEdge
    screen: window.screen
    tracking: window.tabletDock
    interacting: window.menuOpen || window.dragging || appViewport.dragging || bodyPress.active
  }
  readonly property bool shown: (!keyboardEdge.keyboardMapped || keyboardEdge.peeking) && !!dock"""),
        ('&& fullscreenMode < 2', '&& (fullscreenMode < 2 || keyboardEdge.peeking)'),
        ('readonly property bool tucked: autohide &&', 'readonly property bool tucked: !keyboardEdge.peeking && autohide &&'),
        ('exclusiveZone: tabletDock && shown && !autohide', 'exclusiveZone: tabletDock && shown && !keyboardEdge.keyboardMapped && !autohide'),
        ('WlrLayershell.layer: WlrLayer.Top', 'WlrLayershell.layer: keyboardEdge.peeking ? WlrLayer.Overlay : WlrLayer.Top'),
        ('    id: body\n', '    id: body\n    PointHandler { id: bodyPress; acceptedButtons: Qt.AllButtons }\n'),
    ], '// Trona keyboard-aware dock v1')
    return transform(s, [
        ('    tracking: window.tabletDock', '    tracking: window.tabletDock\n    dockHeight: window.slotSize + window.gap'),
        ('  exclusiveZone: tabletDock && shown', '  exclusiveZone: keyboardEdge.peeking ? -1 : tabletDock && shown'),
        ('    PointHandler { id: bodyPress; acceptedButtons: Qt.AllButtons }', """    PointHandler { id: bodyPress; acceptedButtons: Qt.AllButtons }
    DragHandler {
      enabled: keyboardEdge.peeking && !window.menuOpen
      target: null
      acceptedDevices: PointerDevice.TouchScreen
      xAxis.enabled: false
      onActiveTranslationChanged: {
        if (active && activeTranslation.y >= 24) keyboardEdge.peeking = false
      }
    }"""),
        ('    mouse.onPressed: function(event) {\n      appSlot.dragged = false', """    property bool heldForMenu: false
    mouse.pressAndHoldInterval: 550
    mouse.onPressAndHold: function(event) {
      if (!window.tabletDock || event.button !== Qt.LeftButton || appSlot.dragged || appViewport.dragging || window.dragging) return
      appSlot.heldForMenu = true
      window.openMenu(appSlot.modelData, appSlot)
    }
    mouse.onPressed: function(event) {
      appSlot.heldForMenu = false
      appSlot.dragged = false"""),
        ('if (appViewport.interactive || !(appSlot.mouse.pressedButtons', 'if (appSlot.heldForMenu || appViewport.interactive || !(appSlot.mouse.pressedButtons'),
        ('      if (appSlot.dragged) {', '      if (appSlot.heldForMenu || appSlot.dragged) {'),
    ], '// Trona dock hold and dismiss v1')


def patch_grid_back(s):
    anchor = '          Text {\n            anchors.left: parent.left\n            anchors.right: parent.right'
    replacement = """          TronaNavButton {
            id: gridBack
            visible: panel.screen?.name === "DSI-1"
            anchors.right: parent.right
            anchors.verticalCenter: parent.verticalCenter
            width: 48
            height: 48
            onBack: {
              if (root.menuEntry) root.menuEntry = null
              else if (root.filterText) root.setFilter("")
              else root.close()
            }
          }
          Text {
            anchors.left: parent.left
            anchors.right: gridBack.visible ? gridBack.left : parent.right"""
    return transform(s, [(anchor, replacement)], '// Trona app grid back button v1')


def transform(s, changes, marker=MARKER):
    if marker in s:
        return s
    for old, new in changes:
        if s.count(old) != 1:
            raise RuntimeError('Omarchy source changed; review fast-app patch anchor: '+old)
        s=s.replace(old,new,1)
    return marker+'\n'+s

def main():
    ap=argparse.ArgumentParser(description=__doc__)
    ap.add_argument('--shell-dir',type=Path,default=Path('/usr/share/omarchy/shell'))
    args=ap.parse_args()
    # Validate every input before committing either file.
    pending=[]
    for name,fn in [('services/AppLibrary.qml',patch_library),('plugins/dock/Dock.qml',patch_dock),
                    ('plugins/dock/DockWindow.qml',patch_dock_window),('plugins/dock/AppGrid.qml',patch_grid_back)]:
        p=args.shell_dir/name;old=p.read_text();new=fn(old)
        if new!=old:pending.append((p,new))
    for p,new in pending:
        tmp=p.with_suffix('.trona.tmp');tmp.write_text(new);tmp.chmod(p.stat().st_mode);tmp.replace(p)
    print('Trona scoped app launches, native window focus and icon reuse applied.')

if __name__=='__main__':main()
