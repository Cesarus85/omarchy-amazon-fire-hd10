+/* Amazon Trona vendor-firmware CPU hotplug completion.
+ * The original MT8183 hps_v3/mtk_hotplug_cb.c invokes POWER_DOWN_CORE
+ * after CPU_DEAD, in addition to standard PSCI CPU_OFF. The modern
+ * BP_PREPARE teardown runs on a surviving CPU after the target died.
+ * No PLL, voltage, cluster-power or firmware modifications here.
+ */
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/cpu.h>
+#include <linux/cpuhotplug.h>
+#include <linux/arm-smccc.h>
+
+#define TRONA_SIP_POWER_DOWN_CORE 0xc2000218
+static int hp_state;
+static int finish_cpu_off(unsigned int cpu)
+{
+ struct arm_smccc_res r;
+ if (!cpu || cpu>=8 || cpu_online(cpu))return -EINVAL;
+ arm_smccc_smc(TRONA_SIP_POWER_DOWN_CORE,cpu,0,0,0,0,0,0,&r);
+ pr_info("Trona CPU power: CPU%u vendor power-down returned %ld\n",cpu,(long)r.a0);
+ return (long)r.a0<0 ? -EIO : 0;
+}
+static int __init trona_cpu_power_init(void)
+{
+ if(!of_machine_is_compatible("amazon,trona"))return -ENODEV;
+ if(num_possible_cpus()!=8)return -EINVAL;
+ hp_state=cpuhp_setup_state_nocalls(CPUHP_BP_PREPARE_DYN,"soc/trona:cpu-power",NULL,finish_cpu_off);
+ return hp_state<0 ? hp_state : 0;
+}
+static void __exit trona_cpu_power_exit(void){cpuhp_remove_state_nocalls(hp_state);}
+module_init(trona_cpu_power_init);
+module_exit(trona_cpu_power_exit);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Trona vendor CPU power-down completion for PSCI hotplug");
