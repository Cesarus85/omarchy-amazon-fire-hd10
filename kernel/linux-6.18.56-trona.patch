+/* trona: verified LK devinfo calibration.
+ * Amazon devinfo_tag is a LE32 data_size followed by the efuse array.
+ * Vendor tscpu_settings.h: temp1=index100, temp0=index101, temp2=index102.
+ * Mainline V1 uses temp1,temp0,temp2, hence property words 101..103.
+ */
+static void trona_thermal_devinfo(struct device *dev, u32 *buf)
+{
+ const __le32 *w;
+ u32 v[3], count, ge, degc;
+ int len, i;
+ const unsigned int shifts[] = {17, 8, 0, 23, 5, 14};
+ const unsigned int words[] = {0, 0, 1, 2, 2, 2};
+ if (!of_machine_is_compatible("amazon,trona") || !of_chosen)
+  return;
+ w = of_get_property(of_chosen, "atag,devinfo", &len);
+ if (!w || len < 104 * sizeof(*w)) return;
+ count = le32_to_cpu(w[0]);
+ if (count < 103 || count > 300 || len != (count + 1) * sizeof(*w)) return;
+ for (i = 0; i < 3; i++) v[i] = le32_to_cpu(w[101 + i]);
+ if (!(v[0] & BIT(0))) return;
+ ge = (v[1] >> 22) & 0x3ff;
+ degc = (v[0] >> 1) & 0x3f;
+ if (ge < 265 || ge > 758 || !degc) return;
+ for (i = 0; i < 6; i++)
+  if (((v[words[i]] >> shifts[i]) & 0x1ff) > 484) return;
+ memcpy(buf, v, sizeof(v));
+ dev_info(dev, "Using validated Trona LK thermal calibration\n");
+}
